{
  "name": "Level 0 - 黃色房間",
  "intro": "你在潮濕的黃色房間醒來。嗡嗡的日光燈聲讓人不安……找到鑰匙，逃出去。",
  "start": "a",
  "floor": [-1, -1, 26, 8],
  "lights": [[3, 3], [7, 3], [12, 3], [19, 3], [22, 3]],
  "walls": [
    [0, -0.3, 8, 0.3], [0, 6, 8, 0.3], [-0.3, -0.3, 0.3, 6.6],
    [8, -0.3, 0.3, 2.3], [8, 4, 0.3, 2.3],
    [8.3, 1.7, 7.7, 0.3], [8.3, 4, 7.7, 0.3],
    [16, -0.3, 0.3, 2.3], [16, 4, 0.3, 2.3],
    [16, -0.3, 8.3, 0.3], [16, 6, 8.3, 0.3], [24, -0.3, 0.3, 6.6]
  ],
  "nodes": {
    "a":    { "pos": [2, 3],  "face": "E", "label": "房間西側", "links": ["b"] },
    "b":    { "pos": [6, 3],  "face": "E", "label": "房間東側", "links": ["a", "hall"] },
    "hall": { "pos": [12, 3], "face": "E", "label": "走廊",     "links": ["b", "d"] },
    "d":    { "pos": [19, 3], "face": "E", "label": "第二間房", "links": ["hall", "e"] },
    "e":    { "pos": [22, 3], "face": "E", "label": "門前",     "links": ["d"] }
  },
  "objects": [
    { "name": "上鎖的箱子", "at": ["a", "b"], "pos": [3, 0.7], "size": [1, 0.8, 1], "color": "#3a5a7a",
      "doneSay": "箱子已經打開了。",
      "onClick": [
        { "say": "箱子的蓋子卡得很緊，你試著撬開它。" },
        { "check": "STR",
          "ok":   [{ "give": "key" }, { "say": "裡面有一把生鏽的鑰匙。", "cls": "ok" }, { "done": true }],
          "fail": [{ "say": "撬不開。也許再試一次？" }] }
      ] },
    { "name": "牆上的汙漬", "at": ["a"], "pos": [0.15, 3], "size": [0.1, 1.6, 1.6], "color": "#2a2a20",
      "doneSay": "你別開了視線。",
      "onClick": [
        { "say": "牆上有一大片黑色汙漬，形狀像是一張臉。" },
        { "check": "INT",
          "ok":   [{ "say": "你發現汙漬是從天花板滲下來的，而且是溫熱的。", "cls": "ok" }],
          "fail": [{ "san": 4, "why": "你盯著它太久，它似乎眨了眼。" }, { "done": true }] }
      ] },
    { "name": "一張字條", "at": ["a", "b"], "pos": [5, 5], "size": [0.4, 0.2, 0.4], "color": "#ddd6a0",
      "doneSay": "字條已經收好了。",
      "onClick": [
        { "say": "字條上寫著：「不要相信第三個轉角。出口在東邊。」" },
        { "check": "WIS", "fail": [{ "san": 3, "why": "字條上的字跡開始在你眼前蠕動。" }] },
        { "give": "note" }, { "done": true }
      ] },
    { "name": "出口的門", "at": ["d", "e"], "pos": [23.8, 3], "size": [0.2, 2.4, 1.8], "color": "#6a3a2a",
      "onClick": [
        { "need": "key", "else": [{ "say": "門鎖住了，需要鑰匙。", "cls": "bad" }] },
        { "say": "你把鑰匙插進鎖孔，轉動它……" },
        { "check": "DEX",
          "ok":   [{ "say": "門開了，白光湧入。", "cls": "ok" }, { "goto": "level02" }],
          "fail": [{ "say": "鑰匙卡住了，再試一次。" }] }
      ] }
  ]
}
